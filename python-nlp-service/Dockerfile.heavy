# Heavy (training) image for python-nlp-service (CPU-only)
# Use Python 3.10 because some heavy NLP libs (allennlp, flair) require torch < 1.13
FROM python:3.10-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    wget \
    curl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy heavy requirements
COPY requirements.heavy.txt .
COPY requirements.txt .

# Install pip tools, a CPU PyTorch wheel (compatible with allennlp<2.13) and then the
# base + heavy requirements. Preinstalling torch avoids resolver conflicts between
# flair/allennlp/stanza/sentence-transformers which constrain torch to <1.13.
RUN pip install --upgrade pip setuptools wheel && \
    pip install numpy==1.24.3 && \
    # Install a CPU-only PyTorch compatible with allennlp (1.12.x). Use the PyTorch
    # CPU wheels index so pip pulls the +cpu build.
    pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu "torch==1.12.1+cpu" "torchvision==0.13.1+cpu" && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements.heavy.txt

# Copy application
COPY . .

EXPOSE 8002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
