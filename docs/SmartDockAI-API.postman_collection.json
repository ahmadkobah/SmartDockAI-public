                  "key": "tags",
                  "value": "[\"invoice\", \"finance\", \"2025\"]",
                  "type": "text"
                },
                {
                  "key": "metadata",
                  "value": "{\"department\": \"Finance\", \"project\": \"Q4-2025\"}",
