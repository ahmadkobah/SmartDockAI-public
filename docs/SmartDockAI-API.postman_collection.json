        {
          "name": "Get Document Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/:documentId",
              "host": ["{{baseUrl}}"],
              "path": ["documents", ":documentId"],
              "variable": [
                {
                  "key": "documentId",
                  "value": "123"
                }
              ]
