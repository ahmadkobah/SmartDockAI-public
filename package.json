{
  "name": "smartdockai",
  "version": "1.0.0",
  "description": "An intelligent document management system with OCR capabilities, metadata extraction, and AI-powered search.",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start:all": "cross-env START_ALL_SERVICES=true node src/server.js",
    "dev:all": "cross-env NODE_ENV=development START_ALL_SERVICES=true nodemon src/server.js",
    "all": "node start-all.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "preview:client": "npm --prefix client run preview",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "dev:complete": "npm run dev:all",
    "test": "jest",
    "worker": "node src/worker.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "seed": "node scripts/seed-database.js",
    "reset": "node scripts/reset-database.js",
    "setup": "npm run reset && npm run seed && echo 'Setup complete! You can now start the server with: npm run dev'",
    "test:integration": "node scripts/test-integration.js",
    "test:quick": "node scripts/quick-test.js"
  },
  "keywords": [
    "document-management",
    "ocr",
    "metadata-extraction",
    "api",
    "express",
    "nodejs"
  ],
  "author": "Ahmad",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.4"
  }
}
